{
    "name": "kandydrops",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit --pretty",
        "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long src functions/src",
        "graph:architecture": "tsx scripts/export-dependency-graph.ts",
        "check:inventory": "tsx scripts/repo-inventory.ts",
        "agent:index": "tsx scripts/agent/build-agent-indexes.ts",
        "agent:build-index": "npm run agent:index",
        "agent:ui-index": "tsx scripts/agent/build-ui-surface-coverage.ts",
        "agent:task-context": "tsx scripts/agent/build-task-context.ts",
        "agent:build-task-context": "npm run agent:task-context --",
        "agent:fast-start": "tsx scripts/agent/fast-start.ts",
        "agent:verify": "tsx scripts/agent/verification-selector.ts",
        "agent:sync-sql": "tsx scripts/agent/sync-sql.ts",
        "agent:refresh": "npm run agent:index && npm run agent:sync-sql",
        "check:agent-intelligence": "tsx scripts/agent/validate-agent-indexes.ts",
        "check:agent-context": "tsx scripts/agent/check-agent-context.ts",
        "eval:agent-context": "tsx scripts/agent/run-evals.ts",
        "behavioral:rebuild": "tsx scripts/rebuild-behavioral-intelligence.ts",
        "analytics:truth:rebuild": "tsx scripts/rebuild-analytics-truth.ts",
        "check:telemetry": "tsx scripts/audit-telemetry.ts",
        "check:analytics-semantics": "tsx scripts/check-analytics-semantics.ts",
        "check:analytics:continuity": "tsx scripts/check-analytics-continuity.ts",
        "check:admin:parity": "tsx scripts/check-admin-parity.ts",
        "check:admin:fast": "npm run typecheck && npm run check:admin:parity",
        "check:admin:targeted": "vitest run tests/unit/admin-parity.spec.ts tests/unit/admin-user-metrics.spec.ts tests/unit/admin-overview-route.spec.ts tests/unit/admin-support-threads-route.spec.ts tests/unit/admin-moderation-routes.spec.ts tests/unit/admin-content-route.spec.ts tests/unit/admin-ai-drop-covers-route.spec.ts",
        "check:admin:integration": "vitest run tests/unit/admin-users-route.spec.ts tests/unit/admin-debug-route-runtime.spec.ts tests/unit/admin-analytics-live-runtime.spec.ts tests/unit/admin-analytics-page.spec.tsx",
        "check:admin:signoff": "npm run check:admin:fast && npm run check:admin:targeted && npm run check:admin:integration && npm run check:ui:coverage && npm run check:ui:runtime && npm run check:analytics-semantics && npm run check:analytics:continuity",
        "check:firebase-runtime": "tsx scripts/check-firebase-runtime.ts",
        "check:runtime:continuity": "tsx scripts/check-runtime-continuity.ts",
        "check:queue:runtime": "tsx scripts/check-queue-runtime.ts",
        "check:warnings": "tsx scripts/check-warnings.ts",
        "check:scheduler:freshness": "tsx scripts/check-scheduler-freshness.ts",
        "check:firebase:rules": "npm run test:rules:firestore && npm run test:rules:database && npm run test:rules:storage",
        "check:deps": "knip --config knip.json",
        "check:generated-artifacts": "tsx scripts/check-generated-artifacts.ts",
        "check:versions": "syncpack lint",
        "check:outdated": "ncu --packageFile package.json --format group,installedVersion --cooldown 7d && ncu --packageFile functions/package.json --format group,installedVersion --cooldown 7d",
        "check:cycles:app": "tsx scripts/check-cycles.ts app",
        "check:cycles:functions": "tsx scripts/check-cycles.ts functions",
        "check:cycles": "npm run check:cycles:app && npm run check:cycles:functions",
        "sync-ledgers": "npm run check:continuity",
        "trace:adjacent": "tsx scripts/trace-adjacent-surfaces.ts",
        "check:ui:audits": "npm run build && cross-env PLAYWRIGHT_USE_BUILD=1 playwright test tests/ui-audits/runtime.spec.ts tests/ui-audits/accessibility.spec.ts tests/ui-audits/visual-regression.spec.ts --project=chromium --project=\"Mobile Chrome\"",
        "check:ui:coverage": "npm run agent:ui-index && tsx scripts/agent/check-ui-surface-coverage.ts",
        "check:ui:runtime": "npm run agent:ui-index && tsx scripts/agent/build-ui-runtime-audit.ts",
        "check:ui:continuity": "npm run agent:ui-index && npm run check:ui:coverage && npm run check:ui:runtime && npm run check:ui:audits && npm run check:ui:lighthouse",
        "check:ui:omni": "npm run check:ui:audits && npx cypress run",
        "test:ui:cypress": "cypress open",
        "test:ui:storybook": "storybook build",
        "test:ui:puppeteer": "tsx tests/puppeteer/sample.ts",
        "check:ui:lighthouse": "npm run build && node scripts/run-lighthouse-audits.mjs",
        "check:continuity": "npm run check:architecture && npm run check:inventory && npm run check:cycles && npm run check:generated-artifacts",
        "check:functions": "npm --prefix functions run check",
        "test:contracts": "vitest run --config vitest.contracts.config.ts",
        "test:contracts:watch": "vitest --config vitest.contracts.config.ts",
        "test:rules:database": "tsx scripts/run-database-rules-tests.ts",
        "test:rules:firestore": "tsx scripts/run-firestore-rules-tests.ts",
        "test:rules:storage": "tsx scripts/run-storage-rules-tests.ts",
        "prebuild": "tsc --noEmit --pretty",
        "build:debug": "tsc --noEmit --pretty && next build > build.log 2>&1",
        "check": "tsc --noEmit --pretty && eslint . --max-warnings=0 && npm run check:architecture && npm run check:telemetry && npm run check:analytics-semantics && npm run check:firebase-runtime && npm run test:contracts",
        "check:consistency": "npm run check && npm run check:deps && npm run check:versions && npm run check:inventory && npm run check:cycles && npm run check:functions",
        "analyze": "cross-env ANALYZE=true next build --webpack",
        "promote-admin": "tsx scripts/promote-admin.ts",
        "review:admin-panel-logs": "tsx scripts/review-admin-panel-logs.ts",
        "refresh:paypal": "tsx scripts/refresh-paypal-mcp-token.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "agent:preflight": "echo 'Read /control-tower/11-PREFLIGHT-CHECKLIST.md and identify owner before proceeding.'",
        "agent:postflight": "echo 'Read /control-tower/12-POSTFLIGHT-CHECKLIST.md and verify truth hooks before signoff.'",
        "agent:route": "echo 'Consult /control-tower/03-TASK-ROUTING.yaml to find the owner.'",
        "doctrine:locate": "echo 'See /control-tower/08-DOCTRINE-INDEX.md for the master list of doctrine files.'",
        "agent:tooling-check": "echo 'See /control-tower/19-TOOL-AVAILABILITY-MAP.yaml for verified tools and fallback plans.'",
        "agent:jules-schedule": "echo 'See /control-tower/18-JULES-RECURRING-TASKS.md for the Jules execution cadence.'",
        "agent:test": "vitest related --config vitest.contracts.config.ts --run"
    },
