{
  "name": "kandydrops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty",
    "check:telemetry": "tsx scripts/audit-telemetry.ts",
    "check:analytics-semantics": "tsx scripts/check-analytics-semantics.ts",
    "check:analytics-export": "vitest run --config vitest.config.ts tests/contracts/analytics-export-contract.spec.ts",
    "check:firebase-runtime": "tsx scripts/check-firebase-runtime.ts",
    "check:deps": "knip --config knip.json",
    "check:versions": "syncpack lint",
    "check:outdated": "ncu --packageFile package.json --format group,installedVersion --cooldown 7d && ncu --packageFile functions/package.json --format group,installedVersion --cooldown 7d",
    "check:cycles:app": "tsx scripts/check-cycles.ts app",
    "check:cycles:functions": "tsx scripts/check-cycles.ts functions",
    "check:cycles": "npm run check:cycles:app && npm run check:cycles:functions",
    "check:functions": "npm --prefix functions run check",
    "test:contracts": "vitest run --config vitest.config.ts",
    "test:contracts:watch": "vitest --config vitest.config.ts",
    "prebuild": "tsc --noEmit --pretty",
    "build:debug": "tsc --noEmit --pretty && next build > build.log 2>&1",
    "check": "tsc --noEmit --pretty && eslint . --max-warnings=0 && npm run check:telemetry && npm run check:analytics-semantics && npm run check:firebase-runtime && npm run test:contracts",
    "check:consistency": "npm run check && npm run check:deps && npm run check:versions && npm run check:cycles && npm run check:functions",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "promote-admin": "tsx scripts/promote-admin.ts"
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@google-analytics/data": "^5.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.1.7",
    "@next/third-parties": "^16.1.7",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.2",
    "react-loading-skeleton": "^3.5.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.7",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^5.87.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^19.6.5",
    "postcss": "^8.5.8",
    "syncpack": "^14.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@google-cloud/storage": {
      "fast-xml-parser": "^5.5.9"
    },
    "@tootallnate/once": "^3.0.1",
    "flat-cache": {
      "flatted": "^3.4.2"
    },
    "eslint": {
      "ajv": "^6.14.0",
      "minimatch": "^3.1.5"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0",
      "minimatch": "^3.1.5"
    },
    "@eslint/config-array": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-react": {
      "minimatch": "^3.1.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  }
}
