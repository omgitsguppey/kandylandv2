{
  "compilerOptions": {
    "baseUrl": "..",
    "ignoreDeprecations": "6.0",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "types": ["node"],
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src",
    "../shared/runtime/**/*.ts"
  ]
}
