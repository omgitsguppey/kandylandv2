{
  "type": "object",
  "required": ["generatedAt", "generatedAtUtc", "truthOrder", "source", "reportCompleteness", "totalFindingCount", "emittedFindingCount", "omittedFindingCount", "capStrategy", "sourceFileDiscovery", "gitStatus", "toolingDegraded", "currentHeadSource", "freshness", "baselineStatus", "owner", "safetyClass", "costClass", "rollback", "cleanupPolicy", "sourceTruthRole", "commands", "counts"],
  "properties": {
    "generatedAt": { "type": "string" },
    "generatedAtUtc": { "type": "string" },
    "truthOrder": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "array", "items": { "type": "string" } },
    "reportCompleteness": { "type": "string", "enum": ["complete", "sampled", "capped", "degraded", "partial"] },
    "totalFindingCount": { "type": "integer" },
    "emittedFindingCount": { "type": "integer" },
    "omittedFindingCount": { "type": "integer" },
    "capStrategy": { "type": "string" },
    "sourceFileDiscovery": { "type": "string", "enum": ["git", "repo_inventory", "filesystem"] },
    "gitStatus": { "type": "string", "enum": ["available", "missing", "error"] },
    "toolingDegraded": { "type": "boolean" },
    "currentHeadSource": { "type": "string" },
    "freshness": { "type": "string" },
    "baselineStatus": { "type": "string" },
    "owner": { "type": "string" },
    "safetyClass": { "type": "string" },
    "costClass": { "type": "string" },
    "rollback": { "type": "string" },
    "cleanupPolicy": { "type": "string" },
    "sourceTruthRole": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stable_id", "command", "scopeType", "root_or_functions", "requiredWhen", "optionalWhen", "cleanupExpected", "broadSignoffWeight"],
        "properties": {
          "stable_id": { "type": "string" },
          "command": { "type": "string" },
          "scopeType": { "type": "string" },
          "root_or_functions": { "type": "string" },
          "requiredWhen": { "type": "array", "items": { "type": "string" } },
          "optionalWhen": { "type": "array", "items": { "type": "string" } },
          "cleanupExpected": { "type": "array", "items": { "type": "string" } },
          "broadSignoffWeight": { "type": "integer" },
          "verifies_runtime": { "type": "boolean" },
          "verifies_ui": { "type": "boolean" },
          "verifies_rules": { "type": "boolean" },
          "verifies_inventory": { "type": "boolean" },
          "verifies_continuity": { "type": "boolean" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["total", "emitted", "omitted", "byScopeType", "byRoot"],
      "properties": {
        "total": { "type": "integer" },
        "emitted": { "type": "integer" },
        "omitted": { "type": "integer" },
        "byScopeType": { "type": "object" },
        "byRoot": { "type": "object" }
      }
    }
