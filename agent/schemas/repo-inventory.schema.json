{
  "type": "object",
  "required": ["generatedAt", "generatedAtUtc", "truthOrder", "source", "reportCompleteness", "totalFindingCount", "emittedFindingCount", "omittedFindingCount", "capStrategy", "sourceFileDiscovery", "gitStatus", "toolingDegraded", "currentHeadSource", "freshness", "baselineStatus", "owner", "safetyClass", "costClass", "rollback", "cleanupPolicy", "sourceTruthRole", "items", "counts"],
  "properties": {
    "generatedAt": { "type": "string" },
    "generatedAtUtc": { "type": "string" },
    "truthOrder": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "reportCompleteness": { "type": "string", "enum": ["complete", "sampled", "capped", "degraded", "partial"] },
    "totalFindingCount": { "type": "integer" },
    "emittedFindingCount": { "type": "integer" },
    "omittedFindingCount": { "type": "integer" },
    "capStrategy": { "type": "string" },
    "sourceFileDiscovery": { "type": "string", "enum": ["git", "repo_inventory", "filesystem"] },
    "gitStatus": { "type": "string", "enum": ["available", "missing", "error"] },
    "toolingDegraded": { "type": "boolean" },
    "currentHeadSource": { "type": "string" },
    "freshness": { "type": "string" },
    "baselineStatus": { "type": "string" },
    "owner": { "type": "string" },
    "safetyClass": { "type": "string" },
    "costClass": { "type": "string" },
    "rollback": { "type": "string" },
    "cleanupPolicy": { "type": "string" },
    "sourceTruthRole": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stable_id", "path", "file_class", "surface_category", "generated", "evidence_only", "runtime_critical", "likely_shared_helper", "likely_broad_signoff_relevant"],
        "properties": {
          "stable_id": { "type": "string" },
          "path": { "type": "string" },
          "file_class": { "type": "string" },
          "surface_category": { "type": "string" },
          "generated": { "type": "boolean" },
          "evidence_only": { "type": "boolean" },
          "runtime_critical": { "type": "boolean" },
          "workflow_guidance": { "type": "boolean" },
          "governance_artifact": { "type": "boolean" },
          "likely_shared_helper": { "type": "boolean" },
          "likely_broad_signoff_relevant": { "type": "boolean" },
          "dataconnect_related": { "type": "boolean" },
          "functions_related": { "type": "boolean" },
          "last_modified_or_hash": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["total", "emitted", "omitted", "byDomain", "byPrefix"],
      "properties": {
        "total": { "type": "integer" },
        "emitted": { "type": "integer" },
        "omitted": { "type": "integer" },
        "byDomain": { "type": "array", "items": { "type": "object" } },
        "byPrefix": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
