rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Drops: public browsing goes through server-side readers/API routes that sanitize content.
    // Admin UI gets read-only client access for realtime queue/drop management.
    match /drops/{dropId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Users: authenticated read only for SELF; admin UI gets read-only identity resolution.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    // User Runtime: Authenticated read only for SELF, NO client writes (Firebase Admin only)
    match /userRuntime/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // Transactions: authenticated read only for SELF; admin UI gets read-only commerce feeds.
    match /transactions/{transactionId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // Notifications: Authenticated read only for SELF, NO client writes
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.userId);
      allow write: if false;
    }

    // Creator chat threads: participant-scoped client reads for realtime chat only, no direct writes
    match /creator_message_threads/{threadId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && (request.auth.uid == resource.data.creatorId || request.auth.uid == resource.data.userId)
      );
      allow write: if false;
    }

    // Creator chat messages: participant-scoped client reads for realtime chat only, no direct writes
    match /creator_messages/{messageId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && (request.auth.uid == resource.data.creatorId || request.auth.uid == resource.data.userId)
      );
      allow write: if false;
    }

    // Support threads: admin reads for realtime queue, user reads for their own threads, no direct client writes
    match /support_threads/{threadId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if false;
      
      // Support messages: admin reads, user reads if they own the parent thread
      match /support_messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId);
        allow write: if false;
      }
    }

    // Security events: server-only moderation reads, no direct client access or writes
    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin analytics realtime lanes: admin read-only client listeners, server-only writes.
    match /analytics_event_facts/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_guest_batches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_watch_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin realtime diagnostics and rollups: admin read-only client listeners, server-only writes.
    match /adminSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_commerce_rollup/{rollupId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /server_diagnostics/{diagnosticId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /route_runtime_health/{routeKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /runtime_warning_records/{warningId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /debug_evidence/{evidenceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /debug_evidence_rollups/{rollupId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /queue_job_heartbeats/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orchestration_repair_proposals/{proposalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
