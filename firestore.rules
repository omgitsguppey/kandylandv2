rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Drops: NO direct client reads or writes.
    // Public browsing goes through server-side readers/API routes that sanitize content.
    match /drops/{dropId} {
      allow read: if false;
      allow write: if false;
    }
    
    // Users: Authenticated read only for SELF, NO client writes
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Transactions: Authenticated read only for SELF, NO client writes
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Notifications: Authenticated read only for SELF, NO client writes
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
