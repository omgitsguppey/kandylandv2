rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Drops: NO direct client reads or writes.
    // Public browsing goes through server-side readers/API routes that sanitize content.
    match /drops/{dropId} {
      allow read: if false;
      allow write: if false;
    }
    
    // Users: Authenticated read only for SELF, NO client writes
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // User Runtime: Authenticated read only for SELF, NO client writes (Firebase Admin only)
    match /userRuntime/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // Transactions: Authenticated read only for SELF, NO client writes
    match /transactions/{transactionId} {
      allow read: if isSelf(resource.data.userId);
      allow write: if false;
    }

    // Notifications: Authenticated read only for SELF, NO client writes
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.userId);
      allow write: if false;
    }

    // Creator chat threads: participant-scoped client reads for realtime chat only, no direct writes
    match /creator_message_threads/{threadId} {
      allow read: if (
        isSignedIn()
        && (request.auth.uid == resource.data.creatorId || request.auth.uid == resource.data.userId)
      );
      allow write: if false;
    }

    // Creator chat messages: participant-scoped client reads for realtime chat only, no direct writes
    match /creator_messages/{messageId} {
      allow read: if (
        isSignedIn()
        && (request.auth.uid == resource.data.creatorId || request.auth.uid == resource.data.userId)
      );
      allow write: if false;
    }

    // Security events: server-only moderation reads, no direct client access or writes
    match /security_events/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
