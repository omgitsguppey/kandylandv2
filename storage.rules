rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnAvatar(fileName) {
      return isSignedIn()
        && fileName.matches('^' + request.auth.uid + '\\.[A-Za-z0-9]+$');
    }

    function isValidAvatarUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isOwnCreatorMessagePath(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isValidCreatorMessageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }

    function isFinalizedCreatorMessageAttachment() {
      return resource != null
        && resource.metadata != null
        && 'chatAttachmentFinalized' in resource.metadata
        && resource.metadata.chatAttachmentFinalized == 'true';
    }

    match /avatars/{fileName} {
      allow read: if isOwnAvatar(fileName);
      allow write: if isOwnAvatar(fileName)
        && (request.resource == null || isValidAvatarUpload());
    }

    match /creator/messages/{userId}/{allPaths=**} {
      allow read: if isOwnCreatorMessagePath(userId);
      allow create: if isOwnCreatorMessagePath(userId)
        && isValidCreatorMessageUpload();
      allow update, delete: if isOwnCreatorMessagePath(userId)
        && !isFinalizedCreatorMessageAttachment()
        && (request.resource == null || isValidCreatorMessageUpload());
    }

    match /drops/{allPaths=**} {
      // Drop assets are served by server-side routes after admin/creator/entitlement checks.
      // Direct client SDK access cannot prove drop entitlement from this path shape.
      allow get: if false;
      allow list: if false;
      allow write: if false;
    }

    match /landing/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /creator-onboarding/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
