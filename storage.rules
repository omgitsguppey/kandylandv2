rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && fileName.matches(request.auth.uid + '\\..*');
    }

    match /creator/messages/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /drops/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /landing/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
