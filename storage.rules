rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnAvatar(fileName) {
      return isSignedIn()
        && fileName.matches('^' + request.auth.uid + '\\.[A-Za-z0-9]+$');
    }

    function isValidAvatarUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isOwnCreatorMessagePath(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    match /avatars/{fileName} {
      allow read: if isOwnAvatar(fileName);
      allow write: if isOwnAvatar(fileName)
        && (request.resource == null || isValidAvatarUpload());
    }

    match /creator/messages/{userId}/{allPaths=**} {
      allow read, write: if isOwnCreatorMessagePath(userId);
    }

    match /drops/{allPaths=**} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isSignedIn();
    }

    match /landing/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /creator-onboarding/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
